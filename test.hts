func int multiply(int a, int b) {
    return a * b
}

func int compute(int x, int y) {
    return multiply(x, y) + 2
}

main
int factor := 5
int count := 3
int answer := compute(factor, 8)

// Check if compute(5, 8) = 42
if (answer = 42) {
    print("[PASS] Function calls and math returned 42!\n")
} else {
    print("[FAIL] Unexpected math result!\n")
}

