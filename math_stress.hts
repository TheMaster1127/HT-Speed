func int is_even(int n) {
    if (n % 2 = 0) {
        return 1
    }
    return 0
}

main
int a := 100
int b := 30
int remainder := a % b   // 100 % 30 = 10
print("Remainder 100 % 30:\n")
print(remainder)

int check := is_even(remainder)
if (check = 1) {
    print("Remainder is EVEN!\n")
} else {
    print("Remainder is ODD!\n")
}

int complex := (50 - 20 * 2) + (100 / 10) // (50 - 40) + 10 = 20
print("Complex math (should be 20):\n")
print(complex)

exit(0)
